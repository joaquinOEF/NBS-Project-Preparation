node_modules
dist
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
.env
# Generated 250m grid — a build artifact, not source.
#   from the ARVC rasters:  .venv-geo/bin/python scripts/sample-arvc-grid.py
#   from the OEF catalog:   npx tsx scripts/generate-grid-250m.ts
#                           (needs S3 tile access; 403s outside the deploy env)
client/public/sample-data/porto-alegre-grid-250m.json
scripts/output/

# CBO runtime state — moved to the database (cbo_states + cbo_messages tables).
# These folders may still exist on the Replit volume for uploaded files, but
# the JSON state/messages files are no longer the source of truth and must
# never be committed (they contain PII from real CBO conversations).
knowledge/runs/cbo-*/

# knowledge/osm/ is deliberately NOT ignored: the OSM reference-layer snapshots
# are committed so they ship with the deploy (Replit autoscale disks are
# ephemeral). Regenerate with `npm run osm:refresh`.

# Playwright e2e — generated artifacts (regenerable, can be large)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# screenshots produced by the synergy shot harness (scratch)
shots/
